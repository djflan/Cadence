<Project Sdk="Microsoft.NET.Sdk">
  <!-- Fast, deterministic tests. Must never require MIDI hardware, network, or wall-clock timing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cadence.Tests.Unit</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="CsCheck" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Cadence.Application/Cadence.Application.csproj" />
    <ProjectReference Include="../Cadence.Domain/Cadence.Domain.csproj" />
    <ProjectReference Include="../Cadence.Infrastructure/Cadence.Infrastructure.csproj" />
    <ProjectReference Include="../Cadence.Midi/Cadence.Midi.csproj" />
    <ProjectReference Include="../Cadence.Playback/Cadence.Playback.csproj" />
    <ProjectReference Include="../Cadence.PluginWorker/Cadence.PluginWorker.csproj" />
    <ProjectReference Include="../Cadence.Plugins.Protocol/Cadence.Plugins.Protocol.csproj" />
    <ProjectReference Include="../Cadence.Presentation/Cadence.Presentation.csproj" />
    <ProjectReference Include="../Cadence.Profiles/Cadence.Profiles.csproj" />
    <ProjectReference Include="../Cadence.Signal/Cadence.Signal.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Infrastructure/Fixtures/**" CopyToOutputDirectory="PreserveNewest" LinkBase="Infrastructure/Fixtures" />
  </ItemGroup>
</Project>
