<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop composition root and Avalonia views. All behavior lives in Cadence.Presentation and below. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Cadence.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationTitle>Cadence</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Cadence.Presentation/Cadence.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped device profiles are data, copied beside the executable. -->
    <None Include="../../profiles/*.cadence-profile.json" Link="profiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
