<Project Sdk="Microsoft.NET.Sdk">
  <!-- Desktop composition root and Avalonia views. All behavior lives in Cadence.Presentation and below. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Cadence.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationTitle>Cadence</ApplicationTitle>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cadence.Tests.Ui" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Cadence.Platform.Alsa/Cadence.Platform.Alsa.csproj" />
    <ProjectReference Include="../Cadence.Platform.CoreMidi/Cadence.Platform.CoreMidi.csproj" />
    <ProjectReference Include="../Cadence.Platform.Windows/Cadence.Platform.Windows.csproj" />
    <ProjectReference Include="../Cadence.Presentation/Cadence.Presentation.csproj" />
    <!-- Plugins run in this worker, a separate process copied beside the app; it is never loaded into the app. -->
    <ProjectReference Include="../Cadence.PluginWorker/Cadence.PluginWorker.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shipped device profiles are data, copied beside the executable. -->
    <None Include="../../profiles/*.cadence-profile.json" Link="profiles/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
