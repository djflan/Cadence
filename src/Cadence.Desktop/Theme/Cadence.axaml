<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Cadence design system: colour, type, spacing, and control styles layered on Fluent. -->
  <Styles.Resources>
    <Color x:Key="Cadence.BaseColor">#0E1014</Color>
    <Color x:Key="Cadence.PanelColor">#151820</Color>
    <Color x:Key="Cadence.RaisedColor">#1B1F29</Color>
    <Color x:Key="Cadence.HoverColor">#232836</Color>
    <Color x:Key="Cadence.BorderColor">#262B37</Color>
    <Color x:Key="Cadence.BorderStrongColor">#343A48</Color>
    <Color x:Key="Cadence.TextColor">#E8EBF1</Color>
    <Color x:Key="Cadence.TextSecondaryColor">#A3ABBA</Color>
    <Color x:Key="Cadence.TextMutedColor">#6D7586</Color>
    <Color x:Key="Cadence.AccentColor">#3DD6C4</Color>
    <Color x:Key="Cadence.AccentHoverColor">#62E3D4</Color>
    <Color x:Key="Cadence.OnAccentColor">#06211E</Color>
    <Color x:Key="Cadence.DangerColor">#F2555A</Color>
    <Color x:Key="Cadence.WarningColor">#F0B429</Color>
    <Color x:Key="Cadence.SuccessColor">#3DD68C</Color>

    <SolidColorBrush x:Key="Cadence.Base" Color="{StaticResource Cadence.BaseColor}" />
    <SolidColorBrush x:Key="Cadence.Panel" Color="{StaticResource Cadence.PanelColor}" />
    <SolidColorBrush x:Key="Cadence.Raised" Color="{StaticResource Cadence.RaisedColor}" />
    <SolidColorBrush x:Key="Cadence.Hover" Color="{StaticResource Cadence.HoverColor}" />
    <SolidColorBrush x:Key="Cadence.Border" Color="{StaticResource Cadence.BorderColor}" />
    <SolidColorBrush x:Key="Cadence.BorderStrong" Color="{StaticResource Cadence.BorderStrongColor}" />
    <SolidColorBrush x:Key="Cadence.Text" Color="{StaticResource Cadence.TextColor}" />
    <SolidColorBrush x:Key="Cadence.TextSecondary" Color="{StaticResource Cadence.TextSecondaryColor}" />
    <SolidColorBrush x:Key="Cadence.TextMuted" Color="{StaticResource Cadence.TextMutedColor}" />
    <SolidColorBrush x:Key="Cadence.Accent" Color="{StaticResource Cadence.AccentColor}" />
    <SolidColorBrush x:Key="Cadence.AccentHover" Color="{StaticResource Cadence.AccentHoverColor}" />
    <SolidColorBrush x:Key="Cadence.OnAccent" Color="{StaticResource Cadence.OnAccentColor}" />
    <SolidColorBrush x:Key="Cadence.Danger" Color="{StaticResource Cadence.DangerColor}" />
    <SolidColorBrush x:Key="Cadence.Warning" Color="{StaticResource Cadence.WarningColor}" />
    <SolidColorBrush x:Key="Cadence.Success" Color="{StaticResource Cadence.SuccessColor}" />

    <FontFamily x:Key="Cadence.MonoFont">SF Mono, Cascadia Mono, JetBrains Mono, Menlo, Consolas, DejaVu Sans Mono, monospace</FontFamily>
    <CornerRadius x:Key="Cadence.PanelRadius">4</CornerRadius>
    <CornerRadius x:Key="Cadence.ControlRadius">3</CornerRadius>

    <!-- Fluent's own radii, so combo boxes, text fields, steppers, and flyouts match. -->
    <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>

    <!-- Icons (16-unit boxes) -->
    <StreamGeometry x:Key="Icon.Play">M4,2 L14,8 L4,14 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pause">M3,2 H6.5 V14 H3 Z M9.5,2 H13 V14 H9.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Stop">M3,3 H13 V13 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Start">M2,2 H4 V14 H2 Z M14,2 L5,8 L14,14 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Loop">M3,7 A5,4.5 0 0 1 13,6 L13,4 M13,6 L11,6 M13,9 A5,4.5 0 0 1 3,10 L3,12 M3,10 L5,10</StreamGeometry>
    <StreamGeometry x:Key="Icon.Panic">M7,2 H9 V10 H7 Z M7,12 H9 V14 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Undo">M5,3 L2,6 L5,9 M2,6 H10 A4,4 0 0 1 10,14 H7</StreamGeometry>
    <StreamGeometry x:Key="Icon.Redo">M11,3 L14,6 L11,9 M14,6 H6 A4,4 0 0 0 6,14 H9</StreamGeometry>
    <StreamGeometry x:Key="Icon.Plus">M7,2 H9 V7 H14 V9 H9 V14 H7 V9 H2 V7 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Logo">M1,9 H4 V15 H1 Z M6,5 H9 V15 H6 Z M11,1 H14 V15 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Check">M2,8 L6,12 L14,4 L12.6,2.6 L6,9.2 L3.4,6.6 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Warning">M8,1 L15,14 H1 Z M7.2,5 V10 H8.8 V5 Z M7.2,11 V12.6 H8.8 V11 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Offline">M8,1 A7,7 0 1 1 7.99,1 Z M5,4 L4,5 L11,12 L12,11 Z</StreamGeometry>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Cadence.Base}" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.Text}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Panels -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Cadence.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Cadence.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Cadence.PanelRadius}" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Cadence.Raised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Cadence.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Cadence.ControlRadius}" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <!-- Type -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource Cadence.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Cadence.TextMuted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.readout">
    <Setter Property="FontFamily" Value="{StaticResource Cadence.MonoFont}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="{StaticResource Cadence.ControlRadius}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.TextSecondary}" />
  </Style>
  <Style Selector="DropDownButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.transport:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.transport:disabled PathIcon">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.Accent}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.AccentHover}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Cadence.Hover}" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.Text}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Cadence.Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Cadence.AccentHover}" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.OnAccent}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Cadence.Danger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.Danger}" />
  </Style>

  <!-- Transport -->
  <Style Selector="Button.transport, ToggleButton.transport">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.transport:pointerover /template/ ContentPresenter, ToggleButton.transport:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Cadence.Hover}" />
  </Style>
  <Style Selector="Button.transport.play">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{StaticResource Cadence.Accent}" />
  </Style>
  <Style Selector="Button.transport.play:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Cadence.AccentHover}" />
  </Style>
  <Style Selector="Button.transport.play PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Cadence.OnAccent}" />
  </Style>
  <Style Selector="ToggleButton.transport:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="#1F3D3A" />
  </Style>
  <Style Selector="ToggleButton.transport:checked PathIcon">
    <Setter Property="Foreground" Value="{StaticResource Cadence.Accent}" />
  </Style>
  <Style Selector="PathIcon.stroke">
    <Setter Property="Template">
      <ControlTemplate>
        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
          <Path Data="{TemplateBinding Data}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" Width="16" Height="16" />
        </Viewbox>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Mute / Solo pills: letter plus colour, and the full word for screen readers. -->
  <Style Selector="ToggleButton.pill">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Cadence.Hover}" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.TextSecondary}" />
  </Style>
  <Style Selector="ToggleButton.pill.mute:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Cadence.Warning}" />
    <Setter Property="Foreground" Value="#2A1E00" />
  </Style>
  <Style Selector="ToggleButton.pill.solo:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Cadence.Accent}" />
    <Setter Property="Foreground" Value="{StaticResource Cadence.OnAccent}" />
  </Style>

  <!-- Status chips -->
  <Style Selector="Border.chip">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Background" Value="{StaticResource Cadence.Hover}" />
  </Style>
  <Style Selector="Border.chip.ready">
    <Setter Property="Background" Value="#14322B" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Cadence.Success}" />
  </Style>
  <Style Selector="Border.chip.attention">
    <Setter Property="Background" Value="#3A2F12" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Cadence.Warning}" />
  </Style>
  <Style Selector="Border.chip.offline">
    <Setter Property="Background" Value="#3A1A1D" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Cadence.Danger}" />
  </Style>

  <!-- Dense lists (messages, monitor) -->
  <Style Selector="ListBox.dense ListBoxItem">
    <Setter Property="Padding" Value="14,2" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- Track list rows -->
  <Style Selector="ListBox.tracks">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tracks ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tracks ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Cadence.Hover}" />
  </Style>
  <Style Selector="TextBox.inline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox.inline:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Cadence.Raised}" />
  </Style>

  <!-- Keep keyboard focus clearly visible on every restyled control. -->
  <Style Selector=":is(Button):focus-visible /template/ ContentPresenter, ToggleButton:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource Cadence.AccentHover}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
</Styles>
