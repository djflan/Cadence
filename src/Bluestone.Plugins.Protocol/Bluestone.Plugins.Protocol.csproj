<Project Sdk="Microsoft.NET.Sdk">
  <!-- Wire contract shared by the plugin host (Cadence.Plugins) and the plugin worker process: control-plane frames
       and the memory-mapped data-plane block exchange. BCL only; see docs/plugin-hosting.md. -->
  <PropertyGroup>
    <RootNamespace>Cadence.Plugins.Protocol</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Only Exchange/MappedRegion.cs uses pointers; see the comment there. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cadence.Tests.Unit" />
    <InternalsVisibleTo Include="Cadence.Tests.Integration" />
  </ItemGroup>
</Project>
