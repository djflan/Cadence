<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-process plugin worker: hosts plugin instances or scans one module, talking to Bluestone over
       Bluestone.Plugins.Protocol. It hosts only the built-in reference plugins; it never loads native libraries.
       See docs/plugin-hosting.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Bluestone.PluginWorker</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Bluestone.Tests.Unit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Bluestone.Plugins.Protocol/Bluestone.Plugins.Protocol.csproj" />
  </ItemGroup>
</Project>
