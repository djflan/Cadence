<Project Sdk="Microsoft.NET.Sdk">
  <!-- Performance measurements. Run in Release; see docs/adr/0012-performance-baseline.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cadence.Benchmarks</RootNamespace>
    <!-- Benchmark methods must be instance members even when they touch no state (CA1822),
         and BenchmarkDotNet owns disposal of benchmark instances (CA1001). -->
    <NoWarn>$(NoWarn);CA1822;CA1001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Cadence.Application/Cadence.Application.csproj" />
    <ProjectReference Include="../Cadence.Infrastructure/Cadence.Infrastructure.csproj" />
    <ProjectReference Include="../Cadence.Platform.CoreMidi/Cadence.Platform.CoreMidi.csproj" />
    <ProjectReference Include="../Cadence.Platform.Windows/Cadence.Platform.Windows.csproj" />
    <ProjectReference Include="../Cadence.Playback/Cadence.Playback.csproj" />
    <ProjectReference Include="../Cadence.Profiles/Cadence.Profiles.csproj" />
  </ItemGroup>
</Project>
